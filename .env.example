# Copie para .env e preencha. NUNCA commite o .env.
# Mongo de ORIGEM (somente leitura; mesma colecao gravada pelo consumidor da ativ. 9)
MONGO_URI=mongodb://USUARIO:SENHA@HOST:27017/?authSource=admin
# Colecao do contrato da ativ. 9 (gravada pelo consumidor). O esquema legado da turma
# (iot.sensores) tambem e aceito: MONGO_COLLECTION=sensores com FONTE_FORMATO=auto ou legado.
MONGO_DB=iot
MONGO_COLLECTION=pacotes_brutos
# auto = detecta por documento (recebido_em -> pacotes_brutos, received_at -> legado)
FONTE_FORMATO=auto

# MariaDB de destino (serie limpa, agregados, quarentena)
MARIADB_URL=mysql+pymysql://USUARIO:SENHA@HOST:3306/NOME_DO_BANCO?charset=utf8mb4

# Redis de destino (ultimo valor por no e metrica)
REDIS_URL=redis://:SENHA@HOST:6379/0

# Prefixo obrigatorio da disciplina: tabelas jonah_*, chaves Redis jonah:*
PREFIXO=jonah

# Loop continuo
POLL_SEGUNDOS=10
LOTE=500
SOBREPOSICAO_SEGUNDOS=120
# Telemetria a cada 30 min (minimo do firmware no canal publico) -> lacuna = mais de 60 min
INTERVALO_ESPERADO_MIN=30
